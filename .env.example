# Sao chép thành .env và điền giá trị thật. Không commit file .env.

# Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
# mock: dùng dữ liệu giả (test, eval, demo); real: gọi Jira thật
JIRA_MODE=mock
# Id các custom field khác nhau theo từng site; chạy scripts/smoke_jira.py để xem
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_SPRINT_FIELD=customfield_10020
JIRA_FLAGGED_FIELD=customfield_10021

# LLM
LLM_API_KEY=your-llm-api-key
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5

# Khóa ký approval_token (chuỗi ngẫu nhiên dài)
APPROVAL_SECRET=change-me-to-a-long-random-string

# Lưu trữ và múi giờ
DB_PATH=data/taskmate.db
TIMEZONE=Asia/Ho_Chi_Minh

# Langfuse
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
